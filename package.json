{
  "name": "market-luck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "test": "node --test tests/*.test.js",
    "test:integration": "node tests/integration.js",
    "test:readable": "node tests/readable-audit-online.js",
    "test:onboarding": "node tests/onboarding-online.js",
    "test:tickets": "node tests/ticket-history-online.js",
    "test:share": "node tests/share-online.js",
    "test:security": "node tests/security-online.js",
    "test:browser:ci": "node tests/browser/ticket-visual-runner.mjs",
    "deploy": "wrangler deploy",
    "format": "prettier --write src public tests scripts *.json *.jsonc",
    "test:online": "node tests/online-checks.js",
    "check:sources": "node scripts/check-market-sources.js",
    "check:public-sources": "node scripts/check-public-sources.js",
    "build:crypto": "esbuild src/beacon.js --bundle --format=esm --target=es2022 --minify --legal-comments=inline --outfile=public/beacon-verifier.js && esbuild src/commitment.js --bundle --format=esm --target=es2022 --minify --legal-comments=inline --outfile=public/commitment-verifier.js"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "^2.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "prettier": "^3.9.10",
    "wrangler": "^4.0.0"
  }
}
