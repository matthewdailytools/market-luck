{
  "name": "market-luck",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": { "DEMO_MODE": "true" },
  "triggers": { "crons": ["0 6 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "market-luck",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "EVIDENCE", "bucket_name": "market-luck-evidence" },
  ],
}
