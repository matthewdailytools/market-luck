{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "market-luck-test",
  "main": "src/entry.js",
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
  "routes": [{ "pattern": "luck-test.example.com", "custom_domain": true }],
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "BEACON_VERIFIER", "class_name": "BeaconVerifier" }],
  },
  "migrations": [
    { "tag": "beacon-verifier-v1", "new_sqlite_classes": ["BeaconVerifier"] },
  ],
  "vars": { "DEMO_MODE": "true", "DEMO_AUTO_DRAW": "true" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "market-luck-test",
      "database_id": "YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "EVIDENCE", "bucket_name": "market-luck-test-evidence" },
  ],
}
