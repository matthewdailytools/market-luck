{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "market-luck-live",
  "main": "src/worker.js",
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
  "routes": [
    {
      "pattern": "luck.example.com",
      "custom_domain": true,
    },
  ],
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "DEMO_MODE": "false",
    "DEMO_AUTO_DRAW": "false",
    "INSTALLATION_KIND": "LIVE",
  },
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "market-luck-live",
      "database_id": "YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "market-luck-live-evidence",
    },
  ],
}
